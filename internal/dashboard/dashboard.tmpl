    <div class="value blue">{{.Summary.Volumes}}</div>
  </div>
  {{end}}
  <div class="card">
    <div class="label">Images</div>
    <div class="value blue">{{.Summary.Images}}</div>
  </div>
  {{if .Summary.ShowUpdates}}
